# Copy this file to .env and fill in your MongoDB connection string to use
# MongoDB with `npm start`. If MONGODB_URI is not set, the app automatically
# falls back to a local SQLite file (wedding.sqlite).
#
# `npm run dev` always ignores this and uses SQLite, regardless of MONGODB_URI.
MONGODB_URI=

# Optional: port to listen on (defaults to 3000)
# PORT=3000

# Admin dashboard login (required to create/edit events, tables, guests).
# The public "scan the QR code, find your seat" pages do NOT require this.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Used to sign session cookies. Set this to a long random string in
# production; if unset, a random one is generated at startup (which means
# everyone gets logged out whenever the server restarts).
SESSION_SECRET=
