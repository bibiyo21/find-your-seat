{
  "name": "wedding-seating-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Wedding seating planner API (Express) with a Next.js frontend in frontend/",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/run.js start",
    "dev": "node scripts/run.js dev",
    "api": "node server.js",
    "api:dev": "MONGODB_URI= node server.js",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:start": "npm --prefix frontend run start",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "mongodb": "^6.0.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "sql.js": "^1.8.0",
    "xlsx": "^0.18.5"
  }
}
